# Copy this file to .env for local development.
# Never commit secrets.

YSA_API_ADDRESS=:8080
YSA_DATABASE_URL=postgres://ysa:ysa@postgres:5432/youtube_stream_analyzer?sslmode=disable&connect_timeout=5
YSA_WEB_ORIGIN=http://localhost:5173
YSA_API_ORIGIN=http://localhost:8080

# Local YouTube Data Gateway (the Main API remains on port 8080).
PORT=8081
YSA_GATEWAY_TOKENS=local-development-token
YSA_GATEWAY_BEARER_TOKEN=local-development-token
YSA_GATEWAY_CONTINUATION_SECRET=local-development-secret-at-least-32-characters
YSA_CHAT_REPLAY_BASE_URL=http://localhost:8081
YSA_TRANSCRIPT_BASE_URL=http://localhost:8081

# Required when YouTube integration is introduced in Issue #16.
# YSA_YOUTUBE_API_KEY=
