{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "/deploy/docker/gateway.Dockerfile",
    "watchPatterns": [
      "/apps/youtube-data-gateway/**",
      "/deploy/docker/gateway.Dockerfile",
      "/deploy/railway/gateway.json"
    ]
  },
  "deploy": {
    "startCommand": "ysa-gateway",
    "healthcheckPath": "/readyz",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ALWAYS"
  }
}
